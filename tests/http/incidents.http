@host = http://localhost:5080
@aliceIncidentId = 20000000-0000-0000-0000-000000000001

### Health/readiness
GET {{host}}/health
Accept: application/json

### Working list flow
GET {{host}}/api/incidents
Accept: application/json

### Filtered list
GET {{host}}/api/incidents?status=Triaged
Accept: application/json

### Existing details
GET {{host}}/api/incidents/{{aliceIncidentId}}
Accept: application/json

### Missing resource: expected 404 Problem Details
GET {{host}}/api/incidents/99999999-9999-9999-9999-999999999999
Accept: application/json

### Invalid filter: expected 400 Validation Problem Details
GET {{host}}/api/incidents?status=Unknown
Accept: application/json

### Empty but valid list: expected 200 with [] on baseline seed
GET {{host}}/api/incidents?status=Resolved
Accept: application/json

### Lab 1 severity summary: expected 200 application/json (baseline returned 501)
# Contract: JSON array of { "severity": string, "count": number }, no request body.
# Zero-group policy: full list of levels, a level without incidents has count 0.
# Order: explicit criticality order Low, Medium, High, Critical.
# Expected on restored seed: Low 1, Medium 1, High 1, Critical 0.
GET {{host}}/api/incidents/severity-summary
Accept: application/json
